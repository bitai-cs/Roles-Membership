<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
	</configSections>
	<appSettings>
		<add key="AzManConnection" value="data source=.\SQL2K14,1433;initial catalog=AzManLdap;user id=secman;password=secman;"/>
	</appSettings>
	<connectionStrings>
		<add name="AzManLinqToClasses" connectionString="{0}" providerName="System.Data.SqlClient" />
		<add name="AzManEntities" connectionString="metadata=res://*/EF.AzManModel.csdl|res://*/EF.AzManModel.ssdl|res://*/EF.AzManModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;{0}MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
		<!--**** Conexión en Tiempo de Diseño ****-->
		<add name="AzManEntitiesDesingTime" connectionString="metadata=res://*/EF.AzManModel.csdl|res://*/EF.AzManModel.ssdl|res://*/EF.AzManModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=.\SQL2K14,1433;initial catalog=AzManLdap;user id=secman;password=secman;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
	</connectionStrings>
	<entityFramework>
		<defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
			<parameters>
				<parameter value="mssqllocaldb" />
			</parameters>
		</defaultConnectionFactory>
		<providers>
			<provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>
</configuration>